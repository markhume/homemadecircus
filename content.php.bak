	<script>
	$( document ).ready(function() {

		$(document).on('click', 'nav a[href^="#"]', function(e) {
			// target element id
			var id = $(this).attr('href');

			// target element
			var $id = $(id);
			if ($id.length === 0) {
				return;
			}

			// prevent standard hash navigation (avoid blinking in IE)
			e.preventDefault();

			// top position relative to the document
			var pos = $id.offset().top;

			// animated top scrolling
			$('body, html').animate({scrollTop: pos});
		});
		
		
		// animating the content in in boxes 
		  const animatedBoxes = gsap.utils.toArray(".animated-box");
  
  animatedBoxes.forEach((animatedBox, index) => { 
   var content = $(animatedBox);  

      gsap.set(animatedBox, {
      y: 25,
     opacity: 0,
      });
    
        let boxAnimation = gsap.timeline({
      scrollTrigger: {
        trigger: animatedBox,
        pin: false,   // do not pin the trigger element while active
        start: "top 70%",
      }
    });
  
    boxAnimation 
      .to(animatedBox, {
      opacity: 1,
       y: 0,
    })
    
    
  });
		
		// animating the title, image and content in rows with big titles, above 980px
		// 
  let mm = gsap.matchMedia();
	  mm.add("(min-width: 980.1px)", () => {	
		const animatedRows = gsap.utils.toArray(".animated-row");

animatedRows.forEach((animatedRow, index) => { 
  


 var title = $(animatedRow).find(".bigword");
 var swiper = $(animatedRow).find(".moving-image");
	 var text = $(animatedRow).find(".wordcaption");
   var swiperInner = $(swiper).find(".inner");

  
    var split = new SplitText(title, {type: "chars"});
   var titlediv = $(title).find("div");


      gsap.set(titlediv, {
      opacity: 0,
     y: 50,
      });
      gsap.set(swiper, {
      y: 50,
     opacity: 0,
      });
	      gsap.set(text, {
      y: 50,
     opacity: 0,
      });
      gsap.set(swiperInner, {
      y: -50,
      });


    let titleAnimation = gsap.timeline({
      scrollTrigger: {
        trigger: animatedRow,
        pin: false,   // do not pin the trigger element while active
        start: "top 70%",
      }
    });
  
    titleAnimation 
       .to(titlediv, {
      opacity: 1,
      y: 0,
      stagger: 0.05
    })
	      .to(text, {
      opacity: 1,
		y: 0,
    },"<0.3")
      .to(swiper, {
      opacity: 1,
    },"<0.5")
    
  
      let swiperAnimation = gsap.timeline({
      scrollTrigger: {
        trigger: animatedRow,
        pin: false,   // do not pin the trigger element while active
        start: "top 75%",
        end: "bottom 0",
       scrub: true,
      }
    });
  
    swiperAnimation 
      .to(swiper, {
      y: -100,
    })
  
          gsap.to(swiperInner, {
          y: 50,
          ease: "none",
          scrollTrigger: {
            trigger: swiper,
            start: "top bottom",
            end: "bottom top",
            scrub: true } });
      
    });
	  }); // end match media
	});
	</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.4/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.4/ScrollTrigger.min.js"></script>
<script src="/wp-content/themes/HomemadeCircus/assets/js/min/SplitText.min.js"></script>


<?php else: ?>


<article id="post-<?php the_ID(); ?>" <?php post_class(); ?>>

	<div class="row sidenav">

		<div class="col-12 col-lg-3 col-xl-2 sidecolnav" id="activities">
			<?php if(current_user_can('mepr-active','rules:137')): ?> 

				<?php $loop = new WP_Query( array( 'post_type' => 'activity', 'posts_per_page' => -1, 'orderby'=> 'title', 'order' => 'ASC'  ) ); ?>
